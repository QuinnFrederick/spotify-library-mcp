# From https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered on the app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Filled in by `npm run auth`
SPOTIFY_REFRESH_TOKEN=
# Only for the HTTP entry (src/http.js, for the gateway) — `openssl rand -hex 24`
MCP_SECRET=
PORT=8787
